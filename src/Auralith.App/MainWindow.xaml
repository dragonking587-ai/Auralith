<Window
    x:Class="Auralith.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="#050509">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" x:Name="TopRow"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto" x:Name="BottomRow"/>
        </Grid.RowDefinitions>
        <StackPanel x:Name="TopBar" Margin="16,10,16,6" Spacing="6">
            <TextBlock Text="AURALITH" FontSize="20" FontWeight="SemiBold" Foreground="#D4AF37" CharacterSpacing="140"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="Load Image" Click="OnLoadImage"/>
                <Button Content="Remove Image" Click="OnClearImage"/>
                <ComboBox x:Name="FitBox" Width="110" SelectionChanged="OnFitChanged">
                    <ComboBoxItem Content="Fit" IsSelected="True"/>
                    <ComboBoxItem Content="Fill"/>
                    <ComboBoxItem Content="Stretch"/>
                    <ComboBoxItem Content="Center"/>
                </ComboBox>
                <Button Content="Edit" Click="OnEdit"/>
                <Button Content="Preview" Click="OnPreview"/>
                <Button Content="Clean Capture" Click="OnClean"/>
                <Button Content="Fullscreen" Click="OnFullscreen"/>
                <Button Content="Undo" Click="OnUndo"/>
                <Button Content="Redo" Click="OnRedo"/>
                <Button Content="Save Project" Click="OnSaveProject"/>
                <Button Content="Open Project" Click="OnOpenProject"/>
                <TextBlock x:Name="VersionText" VerticalAlignment="Center" Foreground="#9AA3B2"/>
                <Button Content="Check for Updates" Click="OnCheckUpdates"/>
                <Button x:Name="InstallUpdateButton" Content="Download &amp; Install" Click="OnInstallUpdate" Visibility="Collapsed"/>
            </StackPanel>
            <TextBlock x:Name="UpdateStatus" Foreground="#E8E6E3" FontSize="12"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="LeftTools" Margin="12,0,8,0" Spacing="6" Width="120">
                <TextBlock Text="TOOLS" Foreground="#D4AF37"/>
                <Button Content="Select" Click="OnToolSelect"/>
                <Button Content="Trace" Click="OnToolTrace"/>
                <Button Content="Stamp" Click="OnToolStamp"/>
                <Button Content="Emitter" Click="OnToolEmitter"/>
                <CheckBox x:Name="OverlayCheck" Content="Show overlays" IsChecked="True" Checked="OnOverlayToggle" Unchecked="OnOverlayToggle"/>
                <TextBlock x:Name="ToolHint" TextWrapping="Wrap" Foreground="#9AA3B2" FontSize="11" Text="Select a tool, then click the canvas."/>
            </StackPanel>
            <Border x:Name="CanvasBorder" Grid.Column="1" BorderBrush="#D4AF37" BorderThickness="2" Background="#08080C">
                <Grid x:Name="CanvasHost">
                    <Image x:Name="Preview" Stretch="Uniform"/>
                    <Canvas x:Name="Overlay" Background="Transparent"
                            PointerPressed="OnOverlayPressed"
                            PointerMoved="OnOverlayMoved"
                            PointerReleased="OnOverlayReleased"/>
                </Grid>
            </Border>
            <ScrollViewer x:Name="RightPanel" Grid.Column="2" Margin="8,0,12,0">
                <StackPanel Spacing="8">
                    <TextBlock Text="OBJECT" Foreground="#D4AF37"/>
                    <TextBlock x:Name="SelInfo" Text="None selected" Foreground="#E8E6E3" TextWrapping="Wrap"/>
                    <Button Content="Delete selected" Click="OnDeleteSelected"/>
                    <Button Content="Duplicate" Click="OnDuplicate"/>
                    <CheckBox x:Name="MarkerCheck" Content="Show editor marker" IsChecked="True" Checked="OnMarkerToggle" Unchecked="OnMarkerToggle"/>
                    <TextBlock Text="EFFECTS" Foreground="#D4AF37"/>
                    <ComboBox x:Name="AddEffectBox" Width="240"/>
                    <Button Content="+ Add Effect" Click="OnAddEffect"/>
                    <Button Content="Effect Library Status" Click="OnEffectStatus"/>
                    <StackPanel x:Name="EffectList" Spacing="6"/>
                    <TextBlock Text="SELECTED EFFECT" Foreground="#D4AF37"/>
                    <StackPanel x:Name="EffectInspector" Spacing="4"/>
                    <TextBlock Text="MASTER" Foreground="#D4AF37"/>
                    <TextBlock x:Name="MasterLabels" Foreground="#9AA3B2" FontSize="11"/>
                    <Slider x:Name="MasterInt" Minimum="0" Maximum="200" Value="100" Width="240" ValueChanged="OnMasterChanged"/>
                    <Slider x:Name="MasterBri" Minimum="0" Maximum="200" Value="100" Width="240" ValueChanged="OnMasterChanged"/>
                    <Slider x:Name="MasterSens" Minimum="0" Maximum="200" Value="100" Width="240" ValueChanged="OnMasterChanged"/>
                    <TextBlock Text="AUDIO" Foreground="#D4AF37"/>
                    <ComboBox x:Name="DeviceBox" Width="240" SelectionChanged="OnDeviceChanged"/>
                    <Button Content="Start Desktop Audio" Click="OnStartAudio"/>
                    <TextBlock x:Name="AudioStatus" Foreground="#9AA3B2" TextWrapping="Wrap"/>
                    <TextBlock x:Name="Meters" FontFamily="Consolas" Foreground="#E8E6E3" TextWrapping="Wrap"/>
                    <TextBlock x:Name="AudioDiag" FontFamily="Consolas" FontSize="11" Foreground="#9AA3B2" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <TextBlock x:Name="Hud" Grid.Row="2" Margin="16,8,16,10" Foreground="#E8E6E3" FontSize="12"
                   Text="Editor + desktop audio + Group A effects. ESC exits Clean Capture."/>
    </Grid>
</Window>
