{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Auralith",
  "version": "2.0.0-alpha.2",
  "identifier": "ai.auralith.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix .. run desktop:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix .. run desktop:build",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Auralith",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist-desktop": "ui",
      "../vendor/softcam/out/softcam.dll": "softcam.dll"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "publisher": "Auralith",
    "shortDescription": "Local audio-reactive streaming backgrounds",
    "longDescription": "Auralith Desktop runs entirely on your computer. System audio, Smart Detect, Stream Output, and Browser Source stay local. No Netlify or cloud runtime is required after install.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2MTgxNEQ4OTJGMkI5QUEKUldTcXVmS1MyQlFZdGhzdlMvSXIzYnBXMVhsM1YrblZScEpueSsrZzRoOENhdjRZU1FWUWJNdFAK",
      "endpoints": [
        "https://raw.githubusercontent.com/dragonking587-ai/Auralith-desktop-updates/main/latest.json",
        "https://github.com/dragonking587-ai/Auralith/releases/download/auralith-v2-channel/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
