{
  "identifier": "default",
  "description": "Auralith Reborn Preview",
  "windows": [
    "main",
    "poll-host"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "allow-vcam-status",
    "allow-vcam-install",
    "allow-vcam-start",
    "allow-vcam-stop",
    "allow-vcam-push-frame",
    "allow-poll-server-status",
    "allow-poll-server-start",
    "allow-poll-server-set-hub",
    "allow-poll-open-local",
    "allow-poll-detach-host",
    "core:event:default",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-focus",
    "core:webview:allow-create-webview-window",
    "updater:default",
    "process:default"
  ]
}
