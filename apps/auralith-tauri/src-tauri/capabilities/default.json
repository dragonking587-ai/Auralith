{
  "identifier": "default",
  "description": "Auralith Reborn Preview",
  "windows": [
    "main",
    "poll-host"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:default",
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOWNLOAD/**" }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOWNLOAD/**" }
      ]
    },
    "allow-vcam-status",
    "allow-vcam-install",
    "allow-vcam-start",
    "allow-vcam-stop",
    "allow-vcam-push-frame",
    "allow-poll-server-status",
    "allow-poll-server-start",
    "allow-poll-server-set-hub",
    "allow-poll-open-local",
    "allow-poll-detach-host",
    "core:event:default",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-focus",
    "core:webview:allow-create-webview-window",
    "updater:default",
    "process:default"
  ]
}
