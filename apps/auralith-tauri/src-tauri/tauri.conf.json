{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Auralith Tauri Preview",
  "version": "0.1.0",
  "identifier": "com.auralith.tauri.preview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AURALITH",
        "width": 1400,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/dragonking587-ai/Auralith-Releases/releases/latest/download/tauri-preview-latest.json"],
      "pubkey": ""
    }
  }
}
