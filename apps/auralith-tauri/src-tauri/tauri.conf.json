{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Auralith Reborn Dark Gold UI Test",
  "version": "1.0.0-rc.44",
  "identifier": "com.auralith.reborn.darkgoldtest",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AURALITH REBORN — DARK GOLD UI TEST",
        "width": 1440,
        "height": 900,
        "transparent": false,
        "shadow": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": [
      "resources/*"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdEODhERUE4RjBGNDZBOTUKUldTVmF2VHdxTjZJZlh2aHBSdC9aTjF0SWxOUTRKd2NxSlJReDdrK3lFU3BYRGZKT2RlVG5PSVAK",
      "endpoints": [
        "https://example.invalid/auralith-dark-gold-ui-test/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
