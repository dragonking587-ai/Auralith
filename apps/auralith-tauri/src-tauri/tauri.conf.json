{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Auralith Reborn Preview",
  "version": "2.0.0",
  "identifier": "com.auralith.reborn.preview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AURALITH REBORN",
        "width": 1440,
        "height": 900,
        "transparent": false,
        "shadow": false,
        "decorations": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
