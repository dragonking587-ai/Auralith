{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Auralith Host Console",
  "version": "1.0.0-rc.29",
  "identifier": "com.auralith.host.console",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Auralith Host Console",
        "width": 520,
        "height": 780,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
